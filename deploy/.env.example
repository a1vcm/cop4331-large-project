# Production runtime config — copy to /var/www/cop4331-large-project/deploy/.env on the droplet and edit.
# (setup-server.sh creates this for you if it doesn't exist.)
DOMAIN=example.com
JWT_SECRET=change-me-to-a-long-random-string
# Optional: email for Let's Encrypt expiry notices
#LETSENCRYPT_EMAIL=you@example.com

# Required for register/verify-email/forgot-password to actually send email in
# production (without these, the backend just logs the code instead of
# sending it — see backend/utils/mailer.js).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
