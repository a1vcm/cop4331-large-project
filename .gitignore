# ==========================================
# Root-Level Monorepo .gitignore Configuration
# ==========================================

# ------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------
**/node_modules/
jspm_packages/
web_modules/
.pnpm-store
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
.yarn-integrity

# ------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------
**/.env
**/.env.*
!.env.example

# ------------------------------------------
# Logs, Diagnostic Reports & Runtime Data
# ------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
pids
*.pid
*.seed
*.pid.lock

# ------------------------------------------
# Testing & Code Coverage (Required for Unit Tests)
# ------------------------------------------
lib-cov
coverage
*.lcov
.nyc_output

# ------------------------------------------
# Build & Output Directories (Web / Backend)
# ------------------------------------------
**/dist/
**/build/
build/Release
.next
out
.nuxt
.output
.vuepress/dist
.temp
.svelte-kit/
**/.vitepress/dist
**/.vitepress/cache
.docusaurus
.serverless/
.fusebox/

# ------------------------------------------
# Mobile-Specific Exclusions (iOS / Android / Expo)
# ------------------------------------------
# Android binaries and build folders
**/*.apk
**/*.aab
**/android/app/build/
**/android/.gradle/
**/android/build/
*.keystore
!**/android/app/debug.keystore

# iOS build artifacts and CocoaPods
**/ios/Pods/
**/ios/build/
**/*.xcworkspace/
**/*.xcuserdata/

# Expo / React Native general cache
.expo/
*.jks
*.p12

# ------------------------------------------
# IDEs, Editors & OS Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
**/.vscode/
**/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# ------------------------------------------
# Build Tool Caches
# ------------------------------------------
.cache
.parcel-cache
*.tsbuildinfo
.npm
.eslintcache
.stylelintcache
.node_repl_history
*.tgz
.lock-wscript
.grunt
bower_components
.tern-port
.vscode-test
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/
.dynamodb/
.firebase/
