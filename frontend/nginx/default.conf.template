# Production nginx config. ${DOMAIN} is filled in at container start by the
# nginx image's envsubst entrypoint (set DOMAIN in /var/www/cop4331-large-project/deploy/.env on the server).

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    # Let's Encrypt HTTP-01 challenge (served from the shared certbot volume)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN} www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # API -> backend container on the internal compose network
    location /api/ {
        proxy_pass http://backend:5001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # React SPA
    root /usr/share/nginx/html;
    index index.html;

    # Vite fingerprints build output filenames with a content hash, so any
    # file under /assets/ is safe to cache forever — a code change always
    # ships under a new filename, never mutates one already cached.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html (and any other file matched by the SPA fallback below)
    # must always be revalidated, otherwise browsers/CDNs can pin visitors
    # to a stale build that references assets which no longer exist.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
