# Copy to .env and fill in real values. Never commit .env.
MONGODB_URI=mongodb://localhost:27017/poost
PORT=5001
JWT_SECRET=change-me

# Optional: without these, register/verify/reset-password still work locally —
# emails are printed to the console instead of sent. See backend/utils/mailer.js.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
